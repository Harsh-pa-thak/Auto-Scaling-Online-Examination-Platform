generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

model User {
  id              String         @id @default(uuid())
  name            String
  email           String         @unique
  institutionalId String?        @unique
  passwordHash    String
  role            Role           @default(STUDENT)
  status          UserStatus     @default(ACTIVE)
  branch          String?
  semester        Int?
  section         String?
  cgpa            Float?
  phone           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  createdExams    Exam[]         @relation("ExamCreator")
  attempts        Attempt[]
  notifications   Notification[]
}

model Exam {
  id           String         @id @default(cuid())
  title        String
  subject      String
  code         String
  description  String?
  duration     Int
  startTime    DateTime
  endTime      DateTime
  totalMarks   Int
  passingMarks Int
  status       ExamStatus     @default(DRAFT)
  creatorId    String
  creator      User           @relation("ExamCreator", fields: [creatorId], references: [id])
  questions    ExamQuestion[]
  attempts     Attempt[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status, startTime])
  @@index([creatorId])
}

model Question {
  id            String          @id @default(cuid())
  text          String
  option1       String
  option2       String
  option3       String
  option4       String
  correctAnswer Int
  marks         Int             @default(1)
  category      String?
  difficulty    String?
  examQuestions ExamQuestion[]
  answers       AttemptAnswer[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([category, difficulty])
}

model ExamQuestion {
  examId     String
  questionId String
  position   Int
  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([examId, questionId])
  @@unique([examId, position])
}

model Attempt {
  id          String          @id @default(uuid())
  studentId   String
  examId      String
  status      AttemptStatus   @default(IN_PROGRESS)
  startedAt   DateTime        @default(now())
  expiresAt   DateTime
  submittedAt DateTime?
  score       Float?
  student     User            @relation(fields: [studentId], references: [id])
  exam        Exam            @relation(fields: [examId], references: [id])
  answers     AttemptAnswer[]

  @@index([studentId, examId, status])
}

model AttemptAnswer {
  id             String   @id @default(uuid())
  attemptId      String
  questionId     String
  selectedOption Int
  awardedMarks   Float    @default(0)
  attempt        Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       Question @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}
